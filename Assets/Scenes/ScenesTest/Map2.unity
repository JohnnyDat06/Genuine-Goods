    - target: {fileID: 395108588613680613, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_LocalPosition.y
      value: -0.69
      objectReference: {fileID: 0}
    - target: {fileID: 1397189132932415457, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_text
      value: "\n\nD\u1EF1 ki\u1EBFn l\xF4 h\xE0ng KARE-FAKE-001 s\u1EBD \u0111\u01B0\u1EE3c
        xu\u1EA5t kho v\xE0o ng\xE0y 25/03/20xx.\nTh\u1EDDi gian: T\u1EEB 1 gi\u1EDD
        s\xE1ng \u0111\u1EBFn 4 gi\u1EDD s\xE1ng (gi\u1EDD \u0111\u1ECBa ph\u01B0\u01A1ng)\nPh\u01B0\u01A1ng
        th\u1EE9c: H\xE0ng s\u1EBD \u0111\u01B0\u1EE3c chia nh\u1ECF v\xE0 v\u1EADn
        chuy\u1EC3n b\u1EB1ng nhi\u1EC1u xe m\xE1y kh\xE1c nhau \u0111\u1EBFn c\xE1c
        \u0111i\u1EC3m b\xE1n l\u1EBB trong th\xE0nh ph\u1ED1.\nC\xE1c \u0111i\u1EC3m
        \u0111\u1EBFn d\u1EF1 ki\u1EBFn theo Map:\nTuy\u1EBFn 1: Giao cho c\xE1c
        ti\u1EC7m thu\u1ED1c nh\u1ECF l\u1EBB t\u1EA1i khu v\u1EF1c \"Ch\u1EE3 \xF4ng
        B\u1EA7u\" v\xE0 \"Ng\xF5 100\".\nTuy\u1EBFn 2: Ph\xE2n ph\xE1t cho c\xE1c
        \u0111\u1EA1i l\xFD online t\u1EA1i \"Khu ph\u1ED1 m\u1EDBi\".\nTuy\u1EBFn
        3: H\xE0ng m\u1EABu s\u1EBD \u0111\u01B0\u1EE3c tu\u1ED3n v\xE0o \"H\u1EBBm
        104\" \u0111\u1EC3 th\u0103m d\xF2 th\u1ECB tr\u01B0\u1EDDng.\nGhi ch\xFA:
        \"\xD4ng Tr\xF9m\" \u0111\xE3 ch\u1EC9 th\u1ECB ph\u1EA3i ti\xEAu th\u1EE5
        h\u1EBFt l\xF4 h\xE0ng trong v\xF2ng 1 tu\u1EA7n \u0111\u1EC3 tr\xE1nh b\u1ECB
        c\u01A1 quan ch\u1EE9c n\u0103ng ph\xE1t hi\u1EC7n. M\u1ECDi ho\u1EA1t \u0111\u1ED9ng
        ph\u1EA3i \u0111\u01B0\u1EE3c th\u1EF1c hi\u1EC7n m\u1ED9t c\xE1ch k\xEDn
        \u0111\xE1o v\xE0 tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u1EC3 l\u1EA1i
        d\u1EA5u v\u1EBFt."
      objectReference: {fileID: 0}
    - target: {fileID: 1397189132932415457, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_fontSize
