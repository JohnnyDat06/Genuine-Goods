PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 395108588613680613, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_LocalPosition.x
      value: -41.14
      objectReference: {fileID: 0}
    - target: {fileID: 395108588613680613, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_LocalPosition.y
      value: 30.71
      objectReference: {fileID: 0}
    - target: {fileID: 1397189132932415457, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_text
      value: "\n\nL\xF4 h\xE0ng KARE-FAKE-001 \u0111\xE3 \u0111\u01B0\u1EE3c nh\u1EADp
        kho th\xE0nh c\xF4ng v\xE0o ng\xE0y 20/03/20xx.\nTh\u1EDDi gian: 2 gi\u1EDD
        s\xE1ng (gi\u1EDD \u0111\u1ECBa ph\u01B0\u01A1ng)\n\u0110\u1ECBa \u0111i\u1EC3m:
        Kho h\xE0ng b\xED m\u1EADt t\u1EA1i khu c\xF4ng nghi\u1EC7p X, ng\u1EE5y
        trang d\u01B0\u1EDBi danh ngh\u0129a m\u1ED9t c\xF4ng ty v\u1EADn chuy\u1EC3n
        h\xE0ng h\xF3a th\xF4ng th\u01B0\u1EDDng.\nPh\u01B0\u01A1ng th\u1EE9c v\u1EADn
        chuy\u1EC3n: Xe t\u1EA3i kh\xF4ng bi\u1EC3n s\u1ED1, \u0111\u01B0\u1EE3c
        h\u1ED9 t\u1ED1ng b\u1EDFi 2 xe m\xE1y \u0111\u1EC3 c\u1EA3nh gi\u1EDBi.\nNg\u01B0\u1EDDi
        nh\u1EADn: M\u1ED9t ng\u01B0\u1EDDi \u0111\xE0n \xF4ng b\xED \u1EA9n c\xF3
        bi\u1EC7t danh \"\xD4ng Tr\xF9m\", kh\xF4ng r\xF5 danh t\xEDnh.\nGhi ch\xFA:
        To\xE0n b\u1ED9 qu\xE1 tr\xECnh di\u1EC5n ra trong im l\u1EB7ng v\xE0 \u0111\u01B0\u1EE3c
        gi\xE1m s\xE1t ch\u1EB7t ch\u1EBD. C\xE1c c\xF4ng nh\xE2n b\u1ED1c d\u1EE1
        h\xE0ng kh\xF4ng \u0111\u01B0\u1EE3c ph\xE9p s\u1EED d\u1EE5ng \u0111i\u1EC7n
        tho\u1EA1i v\xE0 ph\u1EA3i r\u1EDDi \u0111i ngay sau khi ho\xE0n th\xE0nh
        c\xF4ng vi\u1EC7c."
      objectReference: {fileID: 0}
    - target: {fileID: 2394725428435991301, guid: 477d6b5d191dbbd4f9caf6aa49d57a70, type: 3}
      propertyPath: m_text
      value: "\n\n\n\n\n\n      85H3"
      objectReference: {fileID: 0}
