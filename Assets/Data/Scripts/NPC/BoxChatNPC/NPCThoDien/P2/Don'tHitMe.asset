  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Don'tHitMe
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "Anh Th\u1EE3 \u0110i\u1EC7n"
    sentence: "\u0110\u1EEBng l\xE0m h\u1EA1i t\xF4i"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "H\xF9ng"
    sentence: "L\xE0m h\u1EA1i? Ai l\xE0m h\u1EA1i g\xEC c\u1EADu?"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "Anh Th\u1EE3 \u0110i\u1EC7n"
    sentence: "Anh kh\xF4ng ph\u1EA3i l\xE0 ng\u01B0\u1EDDi c\u1EE7a b\u1ECDn ch\xFAng
      \xE0"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "H\xF9ng"
    sentence: "N\xF3i r\xF5 \u0111i chuy\u1EC7n g\xEC \u0111i"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "Anh Th\u1EE3 \u0110i\u1EC7n"
    sentence: "T\xF4i t\u01B0\u1EDFng anh l\xE0 b\u1ECDn chuy\xEAn ph\xE1 h\u1EE7y
      h\xE0ng h\xF3a c\u1EE7a ch\xFAng t\xF4i "
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "H\xF9ng (N\u1ED9i T\xE2m)"
    sentence: "(Th\xEC ra \u0111\xE1m ng\u01B0\u1EDDi khi n\xE3y l\xE0 \u0111\xE1m
      ph\xE1 ho\u1EA1i h\xE0ng h\xF3a c\u1EE7a nh\u1EEFng ng\u01B0\u1EDDi d\xE2n
      trong khu v\u1EF1c n\xE0y , m\xECnh ph\u1EA3i s\u1EDBm b\u1EAFt h\u1EBFt ch\xFAng
      \u0111\u1EC3 tr\u1EA3 l\u1EA1i y\xEAn b\xECnh cho m\u1ECDi ng\u01B0\u1EDDi
      m\u1EDBi \u0111\u01B0\u1EE3c)"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  followUpDialogue: {fileID: 0}
