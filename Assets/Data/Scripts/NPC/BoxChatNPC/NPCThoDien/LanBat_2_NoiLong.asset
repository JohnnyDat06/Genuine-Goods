MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: LanBat_2_NoiLong
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "H\xF9ng"
    sentence: "L\u1EA1i l\xE0 anh. \u0110\xEAm h\xF4m kh\xF4ng v\u1EC1 nh\xE0 v\u1EDBi
      v\u1EE3 con m\xE0 lang thang \u1EDF \u0111\xE2y \xE0?\n"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "Ch\xFA S\xE1u"
    sentence: "Tui... tui c\xF3 nh\xE0 \u0111\u1EC3 v\u1EC1, nh\u01B0ng l\xF2ng kh\xF4ng
      y\xEAn c\u1EADu \u01A1i. C\u1EE9 \u0111\xEAm xu\u1ED1ng, n\u1EB1m xu\u1ED1ng
      l\xE0 l\u1EA1i ngh\u0129 \u0111\u1EBFn ti\u1EC1n b\u1EA1c, kh\xF4ng ng\u1EE7
      \u0111\u01B0\u1EE3c. Con b\xE9 g\xE1i n\xF3 c\u1EE9 \u0111\xF2i b\u1EB1ng \u0111\u01B0\u1EE3c
      c\xE1i c\u1EB7p m\xE0u \u0111\u1ECF cho gi\u1ED1ng b\u1EA1n, m\xE0 tui ch\u1EC9
      mua n\u1ED5i cho n\xF3 c\xE1i c\u1EB7p m\xE0u xanh c\u0169 ngo\xE0i ch\u1EE3
      tr\u1EDDi...\n"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "H\xF9ng"
    sentence: "V\xEC m\u1EA5y chuy\u1EC7n \u0111\xF3 m\xE0 anh l\xE0m li\u1EC1u?\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "Ch\xFA S\xE1u"
    sentence: "C\xF2n v\u1EE3 tui n\u1EEFa... B\u1EA3 b\u1EC7nh, \u0111\xEAm n\xE0o
      c\u0169ng ho. Tui ph\u1EA3i \u0111i mua v\u1EC9 thu\u1ED1c m\xE0u cam cho b\u1EA3,
      m\xE0 ti\u1EC1n kh\xF4ng c\xF3 nhi\u1EC1u n\xEAn ch\u1EC9 mua \u0111\u01B0\u1EE3c
      lo\u1EA1i r\u1EBB nh\u1EA5t, n\xF3 \u0111\u1EF1ng trong c\xE1i h\u1ED9p gi\u1EA5y
      m\xE0u v\xE0ng. Th\u1EB1ng con trai l\u1EDBn th\xEC \xE1o qu\u1EA7n kh\xF4ng
      c\xF3, tui ph\u1EA3i l\u1EA5y c\xE1i \xE1o \u0111\u1ECF c\u0169 c\u1EE7a tui
      s\u1EEDa l\u1EA1i cho n\xF3 m\u1EB7c \u0111\u1EE1... \u0110\xEAm n\xE0o tui
      c\u0169ng d\u1EB1n v\u1EB7t, th\u1EA5y m\xECnh v\xF4 d\u1EE5ng qu\xE1 c\u1EADu
      \u01A1i..."
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  followUpDialogue: {fileID: 0}
