  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Branch_HoiTham
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "May m\xE0 \u0111\u01B0a \u0111i vi\u1EC7n k\u1ECBp con \u1EA1, nghe
      n\xF3i gi\u1EDD c\u0169ng \u1ED5n r\u1ED3i. B\xE1c s\u0129 b\u1EA3o l\xE0 do
      c\u01A1 \u0111\u1ECBa n\xF3 v\u1ED1n b\u1ECB d\u1ECB \u1EE9ng v\u1EDBi \u0111\u1EADu
      ph\u1ED9ng, ch\u1EE9 kh\xF4ng ph\u1EA3i do \u0111\u1ED3 \u0103n c\xF3 \u0111\u1ED9c.
      Nh\u01B0ng m\xE0 ng\u01B0\u1EDDi ta c\u1EE9 \u0111\u1ED3n \u1EA7m l\xEAn l\xE0
      ti\u1EC7m \u0111\xF3 l\xE0m \u0103n gian d\u1ED1i.\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "H\xF9ng (N\u1ED9i t\xE2m)\t"
    sentence: "(R\xF5 r\xE0ng l\xE0 tin \u0111\u1ED3n \u0111\xE3 b\u1ECB b\xF3p m\xE9o.
      Nh\u01B0ng vi\u1EC7c n\xE0y c\u0169ng cho th\u1EA5y ng\u01B0\u1EDDi d\xE2n
      \u0111ang r\u1EA5t nh\u1EA1y c\u1EA3m v\u1EDBi v\u1EA5n \u0111\u1EC1 an to\xE0n
      th\u1EF1c ph\u1EA9m).\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "Th\xF4i, con \u0111i \u0111\xE2u th\xEC c\u0169ng c\u1EA9n th\u1EADn
      \u0103n u\u1ED1ng nh\xE9. Gi\u1EDD c\xF4 ph\u1EA3i \u0111i d\u1EB7n d\xF2 m\u1EA5y
      \u0111\u1EE9a nh\u1ECF trong nh\xE0 m\u1EDBi \u0111\u01B0\u1EE3c. S\u1EE3 qu\xE1!"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  followUpDialogue: {fileID: 0}
