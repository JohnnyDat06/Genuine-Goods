  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Hoi1_DoiThoai_BaTam_Question
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "H\xF9ng"
    sentence: "Ch\xE1u ch\xE0o c\xF4 T\xE1m. Tr\xF4ng c\xF4 c\xF3 v\u1EBB lo l\u1EAFng,
      c\xF3 chuy\u1EC7n g\xEC kh\xF4ng \u1ED5n sao \u1EA1?\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "(Nh\xECn quanh r\u1ED3i h\u1EA1 gi\u1ECDng) Ch\u1EBFt th\u1EADt, H\xF9ng
      \u01A1i. M\u1EDBi nghe chuy\u1EC7n b\xEAn x\xF3m tr\xEAn m\xE0 c\xF4 lo qu\xE1.\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "H\xF9ng"
    sentence: "D\u1EA1? Chuy\u1EC7n g\xEC m\xE0 gh\xEA v\u1EADy c\xF4?\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "Nghe \u0111\xE2u c\xF3 th\u1EB1ng b\xE9 \u0103n ph\u1EA3i c\xE1i b\xE1nh
      ng\u1ECDt c\u1EE7a ti\u1EC7m \"B\u1EBFp Nh\xE0 An\" \u0111\xF3 con. \u0102n
      xong v\u1EC1 nh\xE0 n\xF3 n\u1ED5i m\u1EA9n \u0111\u1ECF kh\u1EAFp ng\u01B0\u1EDDi,
      kh\xF3 th\u1EDF, ph\u1EA3i \u0111i c\u1EA5p c\u1EE9u g\u1EA5p!\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "Nghe \u0111\xE2u c\xF3 th\u1EB1ng b\xE9 \u0103n ph\u1EA3i c\xE1i b\xE1nh
      ng\u1ECDt c\u1EE7a ti\u1EC7m \"B\u1EBFp Nh\xE0 An\" \u0111\xF3 con. \u0102n
      xong v\u1EC1 nh\xE0 n\xF3 n\u1ED5i m\u1EA9n \u0111\u1ECF kh\u1EAFp ng\u01B0\u1EDDi,
      kh\xF3 th\u1EDF, ph\u1EA3i \u0111i c\u1EA5p c\u1EE9u g\u1EA5p!\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices:
      - choiceText: "V\u1EADy l\xE0 do \u0111\u1ED3 \u0103n c\u1EE7a ti\u1EC7m \u0111\xF3
          sao c\xF4?"
        nextDialogue: {fileID: 11400000, guid: 0d54c469b166f6e418a2af28c0e6c580, type: 2}
      - choiceText: "C\u1EADu b\xE9 \u0111\xF3 gi\u1EDD sao r\u1ED3i \u1EA1?"
        nextDialogue: {fileID: 11400000, guid: a1339e985d81a024bbc4daf5b590c13e, type: 2}
  followUpDialogue: {fileID: 0}
