  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Hoi2_DoiThoai_CoHaiBaTam_Branch_XeTai
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "H\xF9ng"
    sentence: "M\u1EA5y chi\u1EBFc xe t\u1EA3i \u0111\xF3 c\xF3 \u0111\u1EB7c \u0111i\u1EC3m
      g\xEC kh\xF4ng \u1EA1? \u0110\u1EC3 ch\xE1u c\xF2n bi\u1EBFt \u0111\u01B0\u1EDDng
      m\xE0 tr\xE1nh.\n"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "B\xE0 T\xE1m\t"
    sentence: "Ai m\xE0 bi\u1EBFt \u0111\u01B0\u1EE3c h\u1EA3 con. Xe n\xF3 c\xF3
      d\xE1n nh\xE3n hi\u1EC7u g\xEC \u0111\xE2u, c\u1EE9 tr\u01A1n tu\u1ED3n tu\u1ED9t
      \xE0. M\xE0 to\xE0n l\u1EF1a l\xFAc v\u1EAFng ng\u01B0\u1EDDi \u1EDF con h\u1EBBm
      cu\u1ED1i ph\u1ED1 n\xF3 m\u1EDBi ch\u1EA1y, m\u1EDD \xE1m l\u1EAFm.\n"
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
  - characterName: "H\xF9ng (N\u1ED9i t\xE2m)"
    sentence: "(H\u1EBBm cu\u1ED1i ph\u1ED1... C\xF3 m\u1ED9t nh\xE0 kho b\u1ECF
      hoang \u1EDF \u0111\xF3)."
    voiceClip: {fileID: 0}
    choiceData:
      choices: []
