  dialogueLines:
  - characterName: "Anh B\u1EA3y Ca S\u0129\t"
    sentence: "Nghe \u0111\xE2u l\xE0 c\xF3 c\u1EA3 chuy\xEAn c\u01A1 ri\xEAng, bay
      ngay trong \u0111\xEAm nay \u0111\xF3! Phen n\xE0y m\xE0 \u0111\u1EC3 n\xF3
      tho\xE1t th\xEC \u0111\xFAng l\xE0 tr\u1EDDi kh\xF4ng c\xF3 m\u1EAFt.\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "H\xF9ng (N\u1ED9i t\xE2m)\t"
    sentence: "(Chuy\xEAn c\u01A1 ri\xEAng... \u0110\xEAm nay. Ph\u1EA3i \u0111i\u1EC1u
      tra ngay. Kh\xF4ng c\xF2n th\u1EDDi gian n\u1EEFa)."
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  followUpDialogue: {fileID: 0}
