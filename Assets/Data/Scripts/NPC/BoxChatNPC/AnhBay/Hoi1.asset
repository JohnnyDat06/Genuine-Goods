  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Hoi1
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "Anh B\u1EA3y Ca S\u0129"
    sentence: "Tr\u1EDDi ban \xE1nh s\xE1ng n\u0103m th\xE1ng t\u01B0 b\u1EC1 ...\u1EE6a
      th\u1EB1ng cu ki\u1EBFm anh c\xF3 chuy\u1EC7n g\xEC"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: Player
    sentence: "Qua nhi\u1EC1u chuy\u1EC7n t\xED ...c\xF3 chuy\u1EC7n g\xEC k\u1EC3
      nghe ch\u01A1i "
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "Anh B\u1EA3y Ca S\u0129"
    sentence: "Chuy\u1EC7n h\u1EA3? \xC0 \u0111\xFAng r\u1ED3i h\xF4m qua anh c\xF3
      nghe n\xF3i c\xF4ng ty d\u01B0\u1EE3c Kare g\xEC \u0111\xF3 ,con H\xE2n \u0103n
      v\xE0o gi\u1EDD \u0111ang n\u1EB1m trong b\u1EC7nh vi\u1EC7n \u0111i\u1EC1u
      tra r\u1ED3i kia k\xECa "
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices:
      - choiceText: "T\xECnh h\xECnh con H\xE2n sao r\u1ED3i anh?"
        nextDialogue: {fileID: 11400000, guid: 2ed4ee54f22e85a4db64f23e54fcf924, type: 2}
      - choiceText: "C\xF4ng ty Kare \u0111\xF3 \u1EDF \u0111\xE2u v\u1EADy anh"
        nextDialogue: {fileID: 11400000, guid: 6abef0cca25e98642ae50ca211954eac, type: 2}
  - characterName: Player
    sentence: "Gh\xEA v\u1EADy sao anh! (C\xF4ng ty n\xE0y r\u1EA5t \u0111\xE1ng
      nghi).\r\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "Anh B\u1EA3y Ca S\u0129"
    sentence: "N\u1EEFa mua g\xEC nh\u1EDB c\u1EA9n th\u1EADn \u0111\xF3 nghe, anh
      \u0111i l\xE0m ti\u1EBFp \u0111\xE2y.\r\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
