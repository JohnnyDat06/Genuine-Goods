  m_Script: {fileID: 11500000, guid: 495d568851805ff4187a025664193204, type: 3}
  m_Name: Hoi1_DoiThoai_AnhBay_Branch_HoiHan
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: "Anh B\u1EA3y Ca S\u0129\t"
    sentence: "Nghe n\xF3i n\u1EB7ng l\u1EAFm, c\xF2n ph\u1EA3i s\xFAc ru\u1ED9t
      \u0111\xF3 m\xE0y. T\u1ED9i nghi\u1EC7p con nh\u1ECF, hi\u1EC1n kh\xF4 \xE0.
      M\xE0 nghe \u0111\xE2u n\u01A1i \u0111\xF3 g\u1EA7n khu ph\u1ED1 may m\u1EAFn
      n\u1EB1m \u1EDF ph\xEDa b\xEAn ph\u1EA3i"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "H\xF9ng (N\u1ED9i t\xE2m)"
    sentence: "(Ph\u1EA3i nhanh ch\xF3ng t\xECm ra ch\xE2n t\u01B0\u1EDBng, kh\xF4ng
      th\u1EC3 \u0111\u1EC3 th\xEAm ng\u01B0\u1EDDi b\u1ECB h\u1EA1i)."
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  - characterName: "Anh B\u1EA3y Ca S\u0129\t"
    sentence: "Th\xF4i, m\xE0y mua g\xEC c\u0169ng nh\u1EDB c\u1EA9n th\u1EADn \u0111\xF3
      nghe, anh \u0111i l\xE0m ti\u1EBFp \u0111\xE2y."
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
    choiceData:
      choices: []
  followUpDialogue: {fileID: 0}
