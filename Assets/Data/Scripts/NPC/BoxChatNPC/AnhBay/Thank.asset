  dialogueLines:
  - characterName: "Anh B\u1EA3y Ca S\u0129 (v\u1EEBa \u0111\u1ECDc b\xE1o v\u1EEBa
      n\xF3i l\u1EDBn)"
    sentence: "Hay qu\xE1! M\u1EA5y anh c\xF4ng an m\xECnh gi\u1ECFi th\u1EADt! \u0110\xE1nh
      s\u1EADp c\u1EA3 m\u1ED9t c\xE1i kho h\xE0ng l\u1EDBn nh\u01B0 v\u1EADy, thu
      gi\u1EEF bao nhi\xEAu l\xE0 h\xE0ng gi\u1EA3. \u0110\xFAng l\xE0 nh\u1EEFng
      ng\u01B0\u1EDDi h\xF9ng c\u1EE7a nh\xE2n d\xE2n!\r\n"
    voiceClip: {fileID: 8300000, guid: c26f246d17aa4b541811277e173c864c, type: 3}
