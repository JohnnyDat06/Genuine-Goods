  dialogueLines:
  - characterName: "Anh Ch\xEDn Qu\xE8 (G\u1EADt g\xF9)"
    sentence: "L\u1EA7n n\xE0y th\xEC b\u1ECDn ch\xFAng h\u1EBFt \u0111\u01B0\u1EDDng
