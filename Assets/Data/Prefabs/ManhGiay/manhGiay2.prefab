  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\n\n\nChi ti\u1EBFt \u0111\u01A1n h\xE0ng:\n-500 h\u1ED9p th\u1EF1c
    ph\u1EA9m ch\u1EE9c n\u0103ng gi\u1EA3 m\u1EA1o \"Kare-Brain\" - B\u1ED5 n\xE3o,
    t\u0103ng c\u01B0\u1EDDng tr\xED nh\u1EDB.\n-1000 h\u1ED9p vi\xEAn u\u1ED1ng
    tr\u1EAFng da nh\xE1i nh\xE3n hi\u1EC7u \"Kare-Skin\".\n-700 h\u1ED9p tr\xE0
    gi\u1EA3m c\xE2n \"Kare-Slim\" kh\xF4ng r\xF5 ngu\u1ED3n g\u1ED1c.\n\nT\u1ED5ng
    gi\xE1 tr\u1ECB \u0111\u01A1n h\xE0ng: 750.000.000 VN\u0110 (Thanh to\xE1n b\u1EB1ng
    ti\u1EC1n m\u1EB7t khi nh\u1EADn h\xE0ng)\nGhi ch\xFA: Y\xEAu c\u1EA7u giao h\xE0ng
    v\xE0o ban \u0111\xEAm. Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u1EC3 l\u1ED9
    th\xF4ng tin."
