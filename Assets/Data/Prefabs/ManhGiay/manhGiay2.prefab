  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\nM\xE3 \u0111\u01A1n h\xE0ng: KARE-FAKE-001\nNg\xE0y \u0111\u1EB7t:
    Ng\xE0y 15 th\xE1ng 03 n\u0103m 20xx\nB\xEAn \u0111\u1EB7t h\xE0ng: C\xF4ng ty
    TNHH Kare\nB\xEAn nh\u1EADn h\xE0ng: Kho h\xE0ng b\xED m\u1EADt t\u1EA1i khu
    c\xF4ng nghi\u1EC7p X\nChi ti\u1EBFt \u0111\u01A1n h\xE0ng:\n-500 h\u1ED9p th\u1EF1c
    ph\u1EA9m ch\u1EE9c n\u0103ng gi\u1EA3 m\u1EA1o \"Kare-Brain\" - B\u1ED5 n\xE3o,
    t\u0103ng c\u01B0\u1EDDng tr\xED nh\u1EDB.\n-1000 h\u1ED9p vi\xEAn u\u1ED1ng
    tr\u1EAFng da nh\xE1i nh\xE3n hi\u1EC7u \"Kare-Skin\".\n-700 h\u1ED9p tr\xE0
    gi\u1EA3m c\xE2n \"Kare-Slim\" kh\xF4ng r\xF5 ngu\u1ED3n g\u1ED1c.\nT\u1ED5ng
    gi\xE1 tr\u1ECB \u0111\u01A1n h\xE0ng: 750.000.000 VN\u0110 (Thanh to\xE1n b\u1EB1ng
    ti\u1EC1n m\u1EB7t khi nh\u1EADn h\xE0ng)\nGhi ch\xFA: Y\xEAu c\u1EA7u giao h\xE0ng
    v\xE0o ban \u0111\xEAm. Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u1EC3 l\u1ED9
    th\xF4ng tin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 40716f3d8e581304aa33b5dbfe4b50ae, type: 2}
